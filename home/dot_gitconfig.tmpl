[core]
	fsmonitor = false
	untrackedcache = true
[user]
	email = jgw@pobox.com
	name = Joel Webber
{{- /* Identity follows the repo, not the machine: anything cloned from the
       fullstorydev org commits as the work address on every machine, and
       everything else (these dotfiles included) as the personal one. */}}
[includeIf "hasconfig:remote.*.url:https://github.com/fullstorydev/**"]
	path = ~/.config/git/fullstory
[includeIf "hasconfig:remote.*.url:git@github.com:fullstorydev/**"]
	path = ~/.config/git/fullstory
[init]
	defaultBranch = main
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else if stat "/usr/lib/git-core/git-credential-libsecret" }}
	helper = /usr/lib/git-core/git-credential-libsecret
{{- else }}
	{{- /* Ubuntu ships libsecret's helper only as source, so most Linux boxes
	       fall back to the plaintext store. Only non-GitHub hosts (e.g.
	       huggingface.co) ever reach it; GitHub goes through gh below. */}}
	helper = store
{{- end }}
{{- /* `gh auth setup-git` writes an absolute path to gh, which differs per
       machine (/opt/homebrew/bin on macOS, /usr/bin on Linux). Resolve it at
       apply time instead of baking in one machine's path. The empty helper
       resets the list so GitHub uses only gh, not the keychain above. */}}
{{- with lookPath "gh" }}
[credential "https://github.com"]
	helper =
	helper = !{{ . }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ . }} auth git-credential
{{- end }}
