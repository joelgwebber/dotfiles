# Ghostty config (managed by chezmoi: ~/dotfiles/home/dot_config/ghostty).
# Reference: `ghostty +show-config --default --docs`, or https://ghostty.org/docs/config
# Reload in a running Ghostty with ctrl+shift+, (Linux) / cmd+shift+, (macOS).

# --- Keybindings ------------------------------------------------------------
#
# Syntax: keybind = <trigger>=<action>   (e.g. keybind = ctrl+shift+t=new_tab)
#   - Bind a trigger to `unbind` to remove a default and pass the key through
#     to the program running in the terminal.
#   - Prefix with `global:` (system-wide), `all:` (every surface), or
#     `unconsumed:` (run the action AND still send the key to the program).
#   - Sequences: ctrl+a>n=new_tab (press ctrl+a, then n).
#   - All actions: `ghostty +list-actions`. Effective binds: `ghostty +list-keybinds`.
#
# Ghostty 1.3 defaults on Linux, for reference (from
# `ghostty +list-keybinds --default`). macOS defaults differ: mostly cmd+<key>
# in place of ctrl+shift+<key>, with cmd+shift+[/] already switching tabs.
#
# Config
#   ctrl+,                    open_config
#   ctrl+shift+,              reload_config
#
# Clipboard & selection
#   ctrl+shift+c, ctrl+insert copy_to_clipboard
#   ctrl+shift+v              paste_from_clipboard
#   shift+insert              paste_from_selection (primary)
#   ctrl+shift+a              select_all
#   shift+arrows              adjust_selection
#
# Font size
#   ctrl+= / ctrl++           increase_font_size:1
#   ctrl+-                    decrease_font_size:1
#   ctrl+0                    reset_font_size
#
# Scrollback
#   shift+page_up/page_down   scroll_page_up / scroll_page_down
#   shift+home / shift+end    scroll_to_top / scroll_to_bottom
#   ctrl+shift+page_up/down   jump_to_prompt:-1 / +1 (needs shell integration)
#   ctrl+shift+f              start_search    (escape: end_search)
#   ctrl+shift+j              write_screen_file:paste  (dump screen to a temp file, paste its path)
#   super+ctrl+shift+j        write_screen_file:copy   (... copy its path)
#   ctrl+alt+shift+j          write_screen_file:open   (... open it in the default app)
#
# Windows
#   ctrl+shift+n              new_window
#   alt+f4                    close_window
#   ctrl+shift+q              quit
#   ctrl+enter                toggle_fullscreen
#
# Tabs
#   ctrl+shift+t              new_tab
#   ctrl+shift+w              close_tab
#   ctrl+tab / ctrl+shift+tab next_tab / previous_tab
#   ctrl+shift+right / left   next_tab / previous_tab
#   ctrl+page_down / page_up  next_tab / previous_tab   (unbound below)
#   alt+1 .. alt+8            goto_tab:N
#   alt+9                     last_tab
#
# Splits
#   ctrl+shift+o              new_split:right
#   ctrl+shift+e              new_split:down
#   ctrl+alt+arrows           goto_split:<direction>
#   super+ctrl+[ / ]          goto_split:previous / next
#   super+ctrl+shift+arrows   resize_split:<direction>,10
#   ctrl+shift+enter          toggle_split_zoom
#
# Misc
#   ctrl+shift+p              toggle_command_palette
#   ctrl+shift+i              inspector:toggle

# Tabs: ctrl+shift+[ / ] like browsers, Zed, VS Code, etc.
keybind = ctrl+shift+[=previous_tab
keybind = ctrl+shift+]=next_tab

# ...and give ctrl+page_up/down back to the terminal apps (nvim, etc.).
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind

theme = Adventure

