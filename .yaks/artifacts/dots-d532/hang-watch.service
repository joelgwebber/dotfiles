[Unit]
Description=Record whether the previous boot ended cleanly (dots-d532)
Documentation=man:journalctl(1)
# The persistent journal must be flushed before we can read the previous boot.
After=systemd-journal-flush.service
Requires=systemd-journal-flush.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hang-watch
# Output lands in the journal under this unit; the script also appends to
# /var/log/hang-watch.log so the tally survives journal rotation.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
